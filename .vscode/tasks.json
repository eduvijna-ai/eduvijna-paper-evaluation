{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Prepare Local API Dependencies",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/infra/scripts/local-api-prepare.ps1"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/infra/scripts/local-api-prepare.ps1"
        ]
      },
      "linux": {
        "command": "bash",
        "args": ["${workspaceFolder}/infra/scripts/local-api-prepare.sh"]
      },
      "osx": {
        "command": "bash",
        "args": ["${workspaceFolder}/infra/scripts/local-api-prepare.sh"]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false,
        "clear": false
      }
    }
  ]
}
