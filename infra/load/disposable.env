# Disposable load/reliability stack — NEVER use for founder MAT.
# Ports intentionally avoid MAT defaults (15432/16379/19000/19001/18000).
#
# Usage (from repo root):
#   docker compose -p eduvijna-disposable-load --env-file infra/load/disposable.env \
#     -f docker-compose.yml up -d --build postgres redis minio api worker
#
# Tear down ONLY this project (safe):
#   docker compose -p eduvijna-disposable-load --env-file infra/load/disposable.env \
#     -f docker-compose.yml down -v

COMPOSE_PROJECT_NAME=eduvijna-disposable-load

POSTGRES_DB=eduvijna_disposable_load
POSTGRES_USER=drill_user
POSTGRES_PASSWORD=drill_pass_disposable_only
POSTGRES_PUBLISH_PORT=25432

REDIS_PUBLISH_PORT=26379

MINIO_API_PORT=29000
MINIO_CONSOLE_PORT=29001
MINIO_ROOT_USER=drillminio
MINIO_ROOT_PASSWORD=drillminio_disposable
S3_ACCESS_KEY=drillminio
S3_SECRET_KEY=drillminio_disposable
S3_BUCKET=eduvijna-disposable-load

API_PUBLISH_PORT=28000
APP_ENV=local
AUTH_TOKEN_SECRET=disposable_load_jwt_secret_not_for_prod
AI_PROVIDER_VISION=fixed
AI_PROVIDER_TEXT=fixed
AI_PROVIDER_AUTHORING=fixed
UPLOAD_SCANNER=fixed
CELERY_TASK_ALWAYS_EAGER=false
PUBLIC_BASE_URL=http://127.0.0.1:28000
FRONTEND_BASE_URL=http://127.0.0.1:3000

# Auth brute-force limits (SPR-001) — keep usable for evidence scripts
AUTH_LOGIN_FAIL_LIMIT_PER_EMAIL_PER_MINUTE=20
AUTH_LOGIN_FAIL_LIMIT_PER_IP_PER_MINUTE=60

# Smaller pool so DB pressure drill can exercise timeouts
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=1
DATABASE_POOL_TIMEOUT_SECONDS=2
