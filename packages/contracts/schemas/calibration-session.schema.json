{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.eduvijna.local/calibration-session.schema.json",
  "title": "CalibrationSession",
  "description": "B17 evaluator calibration session (PEV-049).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "assessment_id",
    "assessment_version_id",
    "title",
    "status",
    "algorithm_version",
    "score_tolerance_abs",
    "score_tolerance_pct",
    "min_cases",
    "activated_by",
    "activated_at",
    "closed_by",
    "closed_at",
    "created_by",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "assessment_id": { "type": "string", "format": "uuid" },
    "assessment_version_id": { "type": "string", "format": "uuid" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["DRAFT", "ACTIVE", "CLOSED"] },
    "algorithm_version": { "type": "string" },
    "score_tolerance_abs": { "type": "number" },
    "score_tolerance_pct": { "type": "number" },
    "min_cases": { "type": "integer", "minimum": 1 },
    "case_count": { "type": "integer", "minimum": 0 },
    "activated_by": { "type": ["string", "null"], "format": "uuid" },
    "activated_at": { "type": ["string", "null"], "format": "date-time" },
    "closed_by": { "type": ["string", "null"], "format": "uuid" },
    "closed_at": { "type": ["string", "null"], "format": "date-time" },
    "created_by": { "type": ["string", "null"], "format": "uuid" },
    "created_at": { "type": ["string", "null"], "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" },
    "cases": { "type": "array" },
    "participants": { "type": "array" }
  }
}
