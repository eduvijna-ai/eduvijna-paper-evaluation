{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.eduvijna.local/integration-credential.schema.json",
  "title": "IntegrationCredential",
  "description": "B19 machine API credential metadata (PEV-055). Secrets never appear here.",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "name", "key_prefix", "enabled"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string" },
    "key_prefix": { "type": "string" },
    "scopes": { "type": "array", "items": { "type": "string" } },
    "scopes_json": { "type": "array", "items": { "type": "string" } },
    "enabled": { "type": "boolean" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "last_used_at": { "type": ["string", "null"], "format": "date-time" },
    "revoked_at": { "type": ["string", "null"], "format": "date-time" },
    "created_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
