{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.eduvijna.local/mastery-evidence.schema.json",
  "title": "MasteryEvidenceList",
  "description": "B8 immutable mastery evidence rows derived from published ledger facts (algorithm B8_V1). No MasteryState.",
  "type": "object",
  "additionalProperties": false,
  "required": ["student_id", "items"],
  "properties": {
    "student_id": { "type": "string", "format": "uuid" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/masteryEvidenceItem" }
    }
  },
  "$defs": {
    "masteryEvidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "published_result_id",
        "assessment_id",
        "assessment_version_id",
        "submission_id",
        "evaluation_run_id",
        "question_evaluation_id",
        "question_version_id",
        "curriculum_id",
        "curriculum_node_id",
        "evidence_type",
        "strength",
        "score_ratio",
        "source_final_score",
        "source_max_mark",
        "mapping_types",
        "mapping_weight",
        "academic_error_codes",
        "review_condition_codes",
        "reason_codes",
        "source_ledger_snapshot_hash",
        "algorithm_version",
        "created_at"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "published_result_id": { "type": "string", "format": "uuid" },
        "assessment_id": { "type": "string", "format": "uuid" },
        "assessment_version_id": { "type": "string", "format": "uuid" },
        "submission_id": { "type": "string", "format": "uuid" },
        "evaluation_run_id": { "type": "string", "format": "uuid" },
        "question_evaluation_id": { "type": "string", "format": "uuid" },
        "question_version_id": { "type": "string", "format": "uuid" },
        "curriculum_id": { "type": "string", "format": "uuid" },
        "curriculum_node_id": { "type": "string", "format": "uuid" },
        "evidence_type": {
          "type": "string",
          "enum": ["CONCEPT", "EXECUTION", "PROCEDURE"]
        },
        "strength": {
          "type": "string",
          "enum": ["STRONG", "WEAK", "INCONCLUSIVE"]
        },
        "score_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "source_final_score": { "type": "number", "minimum": 0 },
        "source_max_mark": { "type": "number", "exclusiveMinimum": 0 },
        "mapping_types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mapping_weight": { "type": ["number", "null"] },
        "academic_error_codes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "review_condition_codes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reason_codes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source_ledger_snapshot_hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "algorithm_version": { "type": "string", "const": "B8_V1" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
