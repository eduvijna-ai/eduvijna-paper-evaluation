{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.eduvijna.local/reassessment-instantiate.schema.json",
  "title": "ReassessmentInstantiateRequest",
  "description": "B14 instantiate APPROVED B9 blueprint into DRAFT Assessment. Teacher supplies real question content; no AI generation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "improvement_assessment_item_id",
          "prompt_text",
          "max_marks"
        ],
        "properties": {
          "improvement_assessment_item_id": {
            "type": "string",
            "format": "uuid"
          },
          "prompt_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "max_marks": {
            "type": "string",
            "description": "Positive Decimal string (teacher-confirmed)."
          },
          "question_type": {
            "type": ["string", "null"],
            "maxLength": 64
          },
          "instructions": {
            "type": ["string", "null"],
            "maxLength": 8000
          }
        }
      }
    }
  }
}
