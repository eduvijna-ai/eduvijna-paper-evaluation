{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.eduvijna.local/improvement-assessment-blueprint.schema.json",
  "title": "ImprovementAssessmentBlueprint",
  "description": "B9 teacher-reviewed improvement-assessment blueprint. Does not create Assessment/Question entities. No external URLs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "improvement_assessment_id",
    "learning_plan_run_id",
    "student_id",
    "curriculum_id",
    "version_number",
    "title",
    "source_evidence_hash",
    "curriculum_graph_hash",
    "input_hash",
    "items"
  ],
  "properties": {
    "schema": { "type": "string" },
    "algorithm_version": { "type": "string", "const": "B9_V1" },
    "improvement_assessment_id": { "type": "string", "format": "uuid" },
    "learning_plan_run_id": { "type": "string", "format": "uuid" },
    "student_id": { "type": "string", "format": "uuid" },
    "curriculum_id": { "type": "string", "format": "uuid" },
    "version_number": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "maxLength": 255 },
    "source_evidence_hash": { "type": "string", "minLength": 64, "maxLength": 64 },
    "curriculum_graph_hash": { "type": "string", "minLength": 64, "maxLength": 64 },
    "input_hash": { "type": "string", "minLength": 64, "maxLength": 64 },
    "generation_source": {
      "type": ["string", "null"],
      "enum": ["AI", "FIXED", "RULES_FALLBACK", null]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_code",
        "learning_recommendation_id",
        "curriculum_node_id",
        "template_kind",
        "question_template_ref",
        "focus",
        "difficulty",
        "sort_order"
      ],
      "properties": {
        "item_code": { "type": "string", "maxLength": 100 },
        "learning_recommendation_id": { "type": "string", "format": "uuid" },
        "curriculum_node_id": { "type": "string", "format": "uuid" },
        "template_kind": {
          "type": "string",
          "enum": [
            "CONCEPT_CHECK",
            "PREREQUISITE_CHECK",
            "PROCEDURE_PRACTICE",
            "EXECUTION_PRACTICE",
            "TRANSFER_CHECK"
          ]
        },
        "question_template_ref": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^CVB:[A-Z_]+:v[0-9]+$"
        },
        "focus": { "type": "string", "maxLength": 5000 },
        "difficulty": {
          "type": "string",
          "enum": ["EASY", "MEDIUM", "HARD"]
        },
        "suggested_marks": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "sort_order": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
