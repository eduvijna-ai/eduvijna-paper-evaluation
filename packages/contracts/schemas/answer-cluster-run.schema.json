{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.eduvijna.local/answer-cluster-run.schema.json",
  "title": "AnswerClusterRun",
  "description": "B18 answer clustering run (PEV-050).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "assessment_id",
    "assessment_version_id",
    "question_id",
    "question_version_id",
    "cohort_definition",
    "algorithm_version",
    "similarity_threshold",
    "source_set_hash",
    "source_result_count",
    "source_published_result_ids",
    "embedding_provider",
    "embedding_model",
    "embedding_model_version",
    "embedding_dim",
    "cluster_count",
    "status",
    "requested_by",
    "requested_at",
    "completed_at",
    "failure_code",
    "failure_detail",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "assessment_id": { "type": "string", "format": "uuid" },
    "assessment_version_id": { "type": "string", "format": "uuid" },
    "question_id": { "type": "string", "format": "uuid" },
    "question_version_id": { "type": "string", "format": "uuid" },
    "cohort_definition": { "type": "object" },
    "algorithm_version": { "type": "string", "minLength": 1 },
    "similarity_threshold": { "type": ["number", "null"] },
    "source_set_hash": { "type": "string", "minLength": 1 },
    "source_result_count": { "type": "integer", "minimum": 0 },
    "source_published_result_ids": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" }
    },
    "embedding_provider": { "type": "string" },
    "embedding_model": { "type": "string" },
    "embedding_model_version": { "type": "string" },
    "embedding_dim": { "type": "integer", "minimum": 1 },
    "cluster_count": { "type": "integer", "minimum": 0 },
    "status": {
      "type": "string",
      "enum": ["PENDING", "COMPLETED", "INSUFFICIENT_SAMPLE", "FAILED"]
    },
    "requested_by": { "type": ["string", "null"], "format": "uuid" },
    "requested_at": { "type": ["string", "null"], "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "failure_code": { "type": ["string", "null"] },
    "failure_detail": { "type": ["string", "null"] },
    "created_at": { "type": ["string", "null"], "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
