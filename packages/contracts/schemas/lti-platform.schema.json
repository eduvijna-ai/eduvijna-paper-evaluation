{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.eduvijna.local/lti-platform.schema.json",
  "title": "LtiPlatform",
  "description": "B19 LTI 1.3 platform configuration (PEV-055).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "name",
    "issuer",
    "client_id",
    "deployment_id",
    "enabled"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string" },
    "issuer": { "type": "string" },
    "client_id": { "type": "string" },
    "deployment_id": { "type": "string" },
    "auth_login_url": { "type": "string" },
    "token_url": { "type": "string" },
    "jwks_url": { "type": "string" },
    "enabled": { "type": "boolean" },
    "role_mapping_json": { "type": "object", "additionalProperties": true },
    "tool_public_jwks_json": { "type": "object", "additionalProperties": true },
    "created_at": { "type": ["string", "null"], "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
