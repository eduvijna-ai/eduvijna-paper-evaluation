{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.eduvijna.local/structured-transcription.schema.json",
  "title": "StructuredTranscription",
  "description": "PEV-013 structured work understanding segments (math, tables, diagrams) with stage-level confidence kept separate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["segments", "transcription_confidence"],
  "properties": {
    "text": { "type": "string", "maxLength": 20000 },
    "latex": { "type": ["string", "null"], "maxLength": 20000 },
    "transcription_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Stage-level confidence; not a per-segment score."
    },
    "unreadable": { "type": "boolean", "default": false },
    "segments": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/TranscriptionSegment" }
    }
  },
  "$defs": {
    "TranscriptionTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows"],
      "properties": {
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": { "type": "string", "maxLength": 500 }
          }
        }
      }
    },
    "TranscriptionSegment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["TEXT", "MATH", "TABLE", "DIAGRAM"],
          "default": "TEXT"
        },
        "step_index": { "type": ["integer", "null"], "minimum": 0 },
        "text": { "type": ["string", "null"], "maxLength": 2000 },
        "latex": { "type": ["string", "null"], "maxLength": 5000 },
        "table": {
          "oneOf": [
            { "$ref": "#/$defs/TranscriptionTable" },
            { "type": "null" }
          ]
        },
        "diagram_description": { "type": ["string", "null"], "maxLength": 5000 },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "start": { "type": ["number", "null"] },
        "end": { "type": ["number", "null"] }
      }
    }
  }
}
