# EduVijna Paper Evaluation — local development defaults ONLY
# Copy to .env and adjust. NEVER commit .env.

APP_NAME=eduvijna-paper-evaluation
APP_ENV=local
API_VERSION=0.1.0
GIT_SHA=local-dev

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=eduvijna
POSTGRES_USER=eduvijna
POSTGRES_PASSWORD=eduvijna_local_dev_only
DATABASE_URL=postgresql+asyncpg://eduvijna:eduvijna_local_dev_only@postgres:5432/eduvijna

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# MinIO (S3-compatible)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=eduvijna_minio
S3_SECRET_KEY=eduvijna_minio_dev_only
S3_BUCKET=eduvijna-papers
S3_REGION=us-east-1
MINIO_ROOT_USER=eduvijna_minio
MINIO_ROOT_PASSWORD=eduvijna_minio_dev_only

# Public host ports (local) — non-default to avoid common Windows/Hyper-V conflicts
MINIO_CONSOLE_PORT=19001
MINIO_API_PORT=19000
POSTGRES_PUBLISH_PORT=15432
REDIS_PUBLISH_PORT=16379
API_PUBLISH_PORT=18000
