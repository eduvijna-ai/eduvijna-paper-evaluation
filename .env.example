# EduVijna Paper Evaluation — local development defaults ONLY
# Copy to .env and adjust. NEVER commit .env.

APP_NAME=eduvijna-paper-evaluation
APP_ENV=local
API_VERSION=0.1.0
GIT_SHA=local-dev

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
AUTH_TOKEN_SECRET=eduvijna_local_jwt_dev_only_change_me
AUTH_TOKEN_TTL_MINUTES=60
AUTH_ALGORITHM=HS256
STUDENT_IMPORT_MAX_BYTES=2000000
STUDENT_IMPORT_MAX_ROWS=5000

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=eduvijna
POSTGRES_USER=eduvijna
POSTGRES_PASSWORD=eduvijna_local_dev_only
DATABASE_URL=postgresql+asyncpg://eduvijna:eduvijna_local_dev_only@postgres:5432/eduvijna

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# MinIO (S3-compatible)
# Docker Compose api/worker hardcode http://minio:9000 (ignore host overrides).
# Host-side pytest against published MinIO should use http://127.0.0.1:19000.
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=eduvijna_minio
S3_SECRET_KEY=eduvijna_minio_dev_only
S3_BUCKET=eduvijna-papers
S3_REGION=us-east-1
MINIO_ROOT_USER=eduvijna_minio
MINIO_ROOT_PASSWORD=eduvijna_minio_dev_only
SUBMISSION_UPLOAD_MAX_BYTES=52428800
SUBMISSION_MAX_PAGES=100
ASSESSMENT_PAPER_UPLOAD_MAX_BYTES=20971520
# Upload malware scan hook (none | fixed). none → NOT_CONFIGURED; never CLEAN.
UPLOAD_SCANNER=none
CELERY_TASK_ALWAYS_EAGER=false

# B5 structure AI provider (none | fixed | openai)
# fixed is local/CI only — never use in production.
AI_PROVIDER_VISION=none
AI_MODEL_IDENTITY=gpt-4o-mini
AI_MODEL_PAGE_ANALYSIS=gpt-4o-mini
AI_MODEL_MAPPING=gpt-4o-mini
AI_MODEL_TRANSCRIPTION=gpt-4o-mini
AI_PROVIDER_TEXT=none
AI_MODEL_STUDENT_REPORT=gpt-4o-mini
AI_MODEL_PARENT_REPORT=gpt-4o-mini
AI_MODEL_LEARNING_PLAN=gpt-4o-mini
AI_MODEL_IMPROVEMENT_BLUEPRINT=gpt-4o-mini
AI_PROVIDER_AUTHORING=none
AI_MODEL_QUESTION_PAPER_PARSE=gpt-4o-mini
AI_MODEL_ANSWER_KEY_PROPOSAL=gpt-4o-mini
AI_MODEL_RUBRIC_PROPOSAL=gpt-4o-mini
AI_MODEL_CURRICULUM_MAPPING_PROPOSAL=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=60
# OPENAI_API_KEY=

# Public host ports (local) — non-default to avoid common Windows/Hyper-V conflicts
MINIO_CONSOLE_PORT=19001
MINIO_API_PORT=19000
POSTGRES_PUBLISH_PORT=15432
REDIS_PUBLISH_PORT=16379
API_PUBLISH_PORT=18000
