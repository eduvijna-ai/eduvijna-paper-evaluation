# Host-side FastAPI / Celery (Cursor/VS Code F5) — copy to apps/api/.env.local
# NEVER commit .env.local. Do not put production credentials here.
#
# These values are for the Windows/macOS HOST process, not Docker Compose DNS.
# Inside Docker, postgres/redis/minio remain valid service names.
# Host F5 must use published ports on 127.0.0.1 (see docker-compose.yml).

APP_NAME=eduvijna-paper-evaluation
APP_ENV=local
ENVIRONMENT=local
API_VERSION=0.1.0
GIT_SHA=local-dev
LOG_LEVEL=INFO

# Local F5 bind is 127.0.0.1:18000 (see .vscode/launch.json).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_TOKEN_SECRET=eduvijna_local_jwt_dev_only_change_me
AUTH_TOKEN_TTL_MINUTES=60
AUTH_ALGORITHM=HS256
STUDENT_IMPORT_MAX_BYTES=2000000
STUDENT_IMPORT_MAX_ROWS=5000

# Published Docker dependency ports (host), not in-compose service names.
DATABASE_URL=postgresql+asyncpg://eduvijna:eduvijna_local_dev_only@127.0.0.1:15432/eduvijna
REDIS_URL=redis://127.0.0.1:16379/0
CELERY_BROKER_URL=redis://127.0.0.1:16379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:16379/1

# Real Celery worker+beat is started by the compound F5 launch (MAT parity).
CELERY_TASK_ALWAYS_EAGER=false

S3_ENDPOINT_URL=http://127.0.0.1:19000
S3_ACCESS_KEY=eduvijna_minio
S3_SECRET_KEY=eduvijna_minio_dev_only
S3_BUCKET=eduvijna-papers
S3_REGION=us-east-1
SUBMISSION_UPLOAD_MAX_BYTES=52428800
SUBMISSION_MAX_PAGES=100
ASSESSMENT_PAPER_UPLOAD_MAX_BYTES=20971520
# fixed = local/MAT exercisable without OpenAI (matches root .env MAT overlay).
UPLOAD_SCANNER=fixed

AI_PROVIDER_VISION=fixed
AI_MODEL_IDENTITY=gpt-4o-mini
AI_MODEL_PAGE_ANALYSIS=gpt-4o-mini
AI_MODEL_MAPPING=gpt-4o-mini
AI_MODEL_TRANSCRIPTION=gpt-4o-mini
AI_MODEL_EVALUATION=gpt-4o-mini
AI_PROVIDER_TEXT=fixed
AI_MODEL_STUDENT_REPORT=gpt-4o-mini
AI_MODEL_PARENT_REPORT=gpt-4o-mini
AI_MODEL_LEARNING_PLAN=gpt-4o-mini
AI_MODEL_IMPROVEMENT_BLUEPRINT=gpt-4o-mini
AI_PROVIDER_AUTHORING=fixed
AI_MODEL_QUESTION_PAPER_PARSE=gpt-4o-mini
AI_MODEL_ANSWER_KEY_PROPOSAL=gpt-4o-mini
AI_MODEL_RUBRIC_PROPOSAL=gpt-4o-mini
AI_MODEL_CURRICULUM_MAPPING_PROPOSAL=gpt-4o-mini
AUTHORING_PARSE_MAX_PAGES=30
AUTHORING_PARSE_MAX_TEXT_CHARS=40000
AUTHORING_PARSE_MAX_PAGE_TEXT_CHARS=8000
AUTHORING_PARSE_MAX_RENDER_PIXELS=4000000
AUTHORING_PARSE_MAX_IMAGE_BYTES=2097152
AI_REQUEST_TIMEOUT_SECONDS=60
# OPENAI_API_KEY=

PUBLIC_BASE_URL=http://127.0.0.1:18000
FRONTEND_BASE_URL=http://127.0.0.1:3000
B19_TEST_PROVIDERS_ENABLED=false
WEBHOOK_ALLOW_INSECURE_DESTINATIONS=false
B19_TEST_INTERNAL_BASE_URL=http://127.0.0.1:18000
B19_TEST_WEBHOOK_SIGNING_SECRET=b19-deterministic-webhook-secret
# INTEGRATION_SECRET_ENCRYPTION_KEY=
