# Local Next.js development defaults (committed).
# `npm run dev` / `pnpm dev` load this automatically — no env prefix required.
# Override with apps/web/.env.local if needed (gitignored).
#
# Browser → http://localhost:3000 → Next same-origin rewrite → http://127.0.0.1:18000

NEXT_PUBLIC_API_MODE=hybrid
NEXT_PUBLIC_API_BASE_URL=
API_UPSTREAM_URL=http://127.0.0.1:18000
