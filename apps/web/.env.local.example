# Host-side Next.js → F5 FastAPI on 127.0.0.1:18000
# Copy to apps/web/.env.local only if you need overrides — NEVER commit .env.local.
#
# Browser → http://localhost:3000 → Next.js same-origin rewrite → http://127.0.0.1:18000
# apps/web/.env.development already sets these for `npm run dev`.

NEXT_PUBLIC_API_MODE=hybrid
NEXT_PUBLIC_API_BASE_URL=
API_UPSTREAM_URL=http://127.0.0.1:18000
