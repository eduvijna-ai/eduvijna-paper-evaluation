# Frontend public env (no secrets)
# mock — all domains mock + demo role login (Playwright B0 / local only)
# hybrid — live HTTP domains via API_UPSTREAM_URL / NEXT_PUBLIC_API_BASE_URL
NEXT_PUBLIC_API_MODE=hybrid
# Set to "production" for real deploy builds — forbids mock API mode.
# NEXT_PUBLIC_DEPLOYMENT_TARGET=production
# Leave empty to use same-origin Next rewrites → API_UPSTREAM_URL (avoids CORS).
NEXT_PUBLIC_API_BASE_URL=
# Server-only upstream for rewrites (not exposed to the browser bundle).
API_UPSTREAM_URL=http://127.0.0.1:18000
